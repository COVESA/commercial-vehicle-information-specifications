#
# Axle attributes
#
Speed:
  datatype: float
  type: sensor
  unit: km/h
  min: 0
  max: 250
  description: The absolute value of the actual speed of the vehicle.
  comment: Calculated as the average of the wheel speeds of the axle influenced by slip and filtered by a frequency range of 5 Hz to 20 Hz.

SpeedDiff:
  datatype: float
  type: sensor
  unit: km/h
  min: -125
  max: 125
  description: the difference between the wheel speed on the right side and on the left side of the axle.

TreadWidth:
  datatype: uint16
  type: attribute
  unit: mm
  description: The lateral distance between the centerlines of the base tires at ground, including camber angle.
               If there are dual rear wheels, measure from the midway points between the inner and outer tires.
  comment: Corresponds to SAE J1100-2009 W101.

TrackWidth:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 2.5
  description: The lateral distance between the centers of the wheels, measured along the spindle, or axle axis.
  comment: Corresponds to SAE J1100-2009 W102. If there are dual rear wheels, measure from the midway points between the inner and outer tires.

AxleWidth:
  datatype: uint16
  type: attribute
  unit: mm
  description: The lateral distance between the wheel mounting faces, measured along the spindle axis.
  comment: Corresponds to SAE J1100-2009 W113.

AxleLoad:
  datatype: float
  type: sensor
  unit: kg
  min: 0
  max: 32127.5
  description: The static vertical load of the vehicle axle.

UncalibratedLoad:
  datatype: float
  type: sensor
  unit: kg
  min: 0
  max: 64255
  description: The static vertical load measured by the towed vehicle at the time of the axle load calibration.

ScaleLoad:
  datatype: float
  type: sensor
  unit: kg
  min: 0
  max: 64255
  description: The static vertical load measured by an external scale at the time of the axle load calibration.

LoadLevel:
  datatype: string
  type: sensor
  allowed: ['LOW_LOAD', 'HEAVY_LOAD', 'MEDIUM_LOAD', 'ERROR', 'NOT_AVAILABLE']
  description: The load case the calibration data belongs to.

NextDistance:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 25
  description: The distance of the wheel base of axle position x to the next axle position  x+1 .

WheelDiameter:
  datatype: float
  type: attribute
  unit: inch
  description: Diameter of wheels (rims without tires), in inches, as per ETRTO / TRA standard.

WheelWidth:
  datatype: float
  type: attribute
  unit: inch
  description: Width of wheels (rims without tires), in inches, as per ETRTO / TRA standard.

SteeringAngle:
  datatype: float
  type: sensor
  unit: degrees
  description: Single track two-axle model steering angle.
               Angle according to ISO 8855. Positive = degrees to the left. Negative = degrees to the right.
  comment: Single track two-axle model steering angle refers to the angle that a centrally mounted wheel would have.
#
# Tire attributes
#
# Tire size can be specified by different systems
# The VSS signals are intended to support both ISO metric tire code and flotation/numeric sizes.
# Note that tires typically specify either tire diameter or aspect ratio, but both are included in VSS
# for convenience, and it is possible for a vehicle to present both attributes as they can be calculated from each other.
# Axle.TireDiameter = Axle.WheelDiameter + ((2 * Axle.TireWidth * Axle.TireAspectRatio) /(100*25.4))

TireDiameter:
  datatype: float
  type: attribute
  unit: inch
  description: Outer diameter of tires, in inches, as per ETRTO / TRA standard.

TireWidth:
  datatype: uint16
  type: attribute
  unit: mm
  description: Nominal section width of tires, in mm, as per ETRTO / TRA standard.

TireAspectRatio:
  datatype: uint8
  type: attribute
  unit: percent
  description: Aspect ratio between tire section height and tire section width, as per ETRTO / TRA standard.

WheelCount:
  datatype: uint8
  type: attribute
  description: Number of wheels on the axle

WheelsConfig:
  datatype: string[]
  allowed: ['Pos1', 'Pos2', 'Pos3', 'Pos4', 'Pos5', 'Pos6', 'Pos7', 'Pos8', 'Pos9', 'Pos10', 'Pos11', 'Pos12', 'Pos13', 'Pos14', 'Pos15']
  type: attribute
  description: The current wheels configuration for the trailer in the identified axle
#
# Wheels on Axles
#
Wheel:
  instances: Pos[1,15]
  type: branch
  description: Wheel signals for axle
#include Wheel.vspec Wheel
