#
# Trailer specification attributes
#

VIN:
  datatype: string
  type: attribute
  description: The trailer identification number as specified in ISO 3779.

TotalRearHeight:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 5
  description: The total height over ground of the vehicle at the rear of the vehicle.

TotalFrontHeight:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 5
  description: The total height over ground of the vehicle at the front of the vehicle.

GroundHeight:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 5
  description: The height over ground for the floor inside the vehicle at the front end of the floor.

FrontHeight:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 5
  description: The height from the bottom most point of the chassis to the top most point of the vehicle at the front of the vehicle.

TotalLength:
  datatype: float
  type: attribute
  unit: m
  min: 0
  max: 25
  description: The total trailer length.
