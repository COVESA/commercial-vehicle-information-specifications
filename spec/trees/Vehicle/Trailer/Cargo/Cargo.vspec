#
# Cargo signals and attributes
#

Hold:
  type: branch
  instances: [1, 2, 3, 4, 5, 6]
  description: Service brake signals

Hold.Temperature:
  datatype: float
  type: sensor
  unit: celsius
  min: -40
  max: 40
  description: The cargo hold temperature measured by the temperature recorder.

HoldDoor:
  type: branch
  instances: [1, 2, 3]
  description: Hold door signals.

HoldDoor.Switch:
  datatype: string
  type: sensor
  allowed: ['OPEN', 'CLOSED', 'ERROR', 'NOT_AVAILABLE']
  description: The closed/open status of the cargo hold door 1 contact switch.

Compartment:
  type: branch
  instances: [1, 2, 3]
  description: Compartment signals.

Compartment.Humidity:
  datatype: float
  type: sensor
  unit: percent
  min: 0
  max: 125
  description: The humidity of the compartment.

Compartment.Oxygen:
  datatype: float
  type: sensor
  unit: percent
  min: 0
  max: 125
  description: The oxygen concentration of the compartment.

HRU:
  type: branch
  description: HRU signals.HRUs control the temperature of the
  comment: HRUs control the temperature of the vehicle cargo space.
#include HRU.vspec HRU
